#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require("../app");
var debug = require("debug")("eduwork-server:server");
var http = require("http");
const config = require("../config");
const db = require("../database/index.js");

// Validasi konfigurasi kritis di entry point yang benar-benar dipakai (node ./bin/www).
if (!config.secretKey) {
	console.error("Error: SECRET_KEY environment variable is required");
	process.exit(1);
}

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(process.env.PORT || "3000");
app.set("port", port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 * Server listen segera (liveness /api/ping tetap berjalan meski DB belum siap);
 * route data dilindungi dbHealthGuard dan mengembalikan 503 sampai DB siap.
 */

server.listen(port);
server.on("error", onError);
server.on("listening", onListening);

if (db.readyState !== 1) {
	console.warn(
		"Database not connected yet; server is listening and data routes will return 503 until ready.",
	);
}

db.on("open", function () {
	console.log("Database connection successful");
});

db.on("error", function (err) {
	console.error("Database connection error:", err);
});

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
	var port = parseInt(val, 10);

	if (isNaN(port)) {
		// named pipe
		return val;
	}

	if (port >= 0) {
		// port number
		return port;
	}

	return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
	if (error.syscall !== "listen") {
		throw error;
	}

	var bind = typeof port === "string" ? "Pipe " + port : "Port " + port;

	// handle specific listen errors with friendly messages
	switch (error.code) {
		case "EACCES":
			console.error(bind + " requires elevated privileges");
			process.exit(1);
			break;
		case "EADDRINUSE":
			console.error(bind + " is already in use");
			process.exit(1);
			break;
		default:
			throw error;
	}
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
	var addr = server.address();
	var bind = typeof addr === "string" ? "pipe " + addr : "port " + addr.port;
	debug("Listening on " + bind);
}
