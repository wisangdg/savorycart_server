# Salin menjadi .env lalu sesuaikan nilainya.
# Server
PORT=3000
NODE_ENV=development

# Database — pilih salah satu:
# 1) URI penuh (prioritas utama, cocok untuk Atlas/hosting)
MONGODB_URI=mongodb://localhost:27017/savorycart
# 2) Atau konfigurasi terpisah (dipakai bila MONGODB_URI kosong)
DB_HOST=localhost
DB_PORT=27017
DB_NAME=savorycart
# DB_USER=
# DB_PASS=

# JWT — WAJIB diisi, server menolak start tanpa ini
SECRET_KEY=ubah-secret-ini
TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# CORS
FRONTEND_URL=http://localhost:5173

# Identitas service
SERVICE_NAME=SavoryCart
